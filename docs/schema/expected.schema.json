{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/schema/expected.schema.json",
  "title": "projectmd golden case expected.json",
  "description": "Normative projection of main.md for one conformance case (testdata/conformance/cases). Exact: no extra keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "project",
    "contracts",
    "diagnostics"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "task",
              "milestone",
              "subproject",
              "deliverable",
              "heading"
            ]
          },
          "checkbox": {
            "enum": [
              "none",
              "open",
              "done",
              "cancelled"
            ]
          },
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "slack": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "commitment_end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "state"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "requested",
              "agreed",
              "overdue",
              "disputed",
              "delivered",
              "unknown"
            ]
          },
          "actor": {
            "enum": [
              "child",
              "parent",
              null
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "code"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "code": {
            "type": "string",
            "pattern": "^[EWI]-[A-Z-]+$"
          }
        }
      }
    }
  }
}
